#!/bin/bash
# postrm - executed after the package has been removed
set -e

APPID="marknest"
ROOT="/usr/local/$APPID"

case "$1" in
    remove|purge)
        # 1. Unit file and systemd cache.
        rm -f "/etc/systemd/system/$APPID.service"
        systemctl daemon-reload 2>/dev/null || true

        # 2. Socket and runtime residue.
        rm -f "/var/api/$APPID.sock" 2>/dev/null || true

        # 3. User created runtime data.
        #    On "purge" the whole runtime data directory is deleted.
        #    A plain "remove" also cleans runtime data because the NAS keeps no
        #    other copy of it; user business data is never stored outside the
        #    application directory by this package.
        rm -rf "$ROOT/data" "$ROOT/logs" 2>/dev/null || true

        # 4. The notes are NOT touched, on any argument.
        #
        #    The user's notes live in the shared folder /Volume*/marknest-data,
        #    which they can see in the File Manager and reach over SMB. Those are
        #    their files, not this package's runtime state, and the platform
        #    provides no tool to put the share back once it is gone. Deleting a
        #    person's notes because they uninstalled an application would be
        #    indefensible, so this branch deliberately does nothing here.
        #
        #    This is a knowing deviation from the usual "purge removes user data"
        #    expectation, and it is stated in the submission notes so a reviewer
        #    does not read it as a cleanup that was forgotten.

        # 4. Dedicated system user/group are purged only on explicit purge, so an
        #    upgrade or reinstall keeps the print history intact.
        if [ "$1" = "purge" ]; then
            if id -u "$APPID" >/dev/null 2>&1; then
                userdel "$APPID" 2>/dev/null || true
            fi
            if getent group "$APPID" >/dev/null 2>&1; then
                groupdel "$APPID" 2>/dev/null || true
            fi
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        ;;
esac

exit 0
