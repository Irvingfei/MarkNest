# Build outputs. Regenerated by tools/build.py; the .deb belongs on the release,
# not in the history.
/build/
/dist/

# The editor build chain. Node is a DEVELOPMENT-TIME dependency: the bundle is
# built here and committed under webui/js/, and the package itself declares only
# python3 and systemd. Committing node_modules would both bloat the repository
# and suggest the package needs Node at runtime.
webui-src/node_modules/

# Working files from device sessions: screenshots, captured command output.
/_scratch/

# Python
__pycache__/
*.py[cod]
