#!/usr/bin/env python3
"""MarkNest for TOS - backend entry point.

Installed at ``/usr/local/marknest/bin/marknest-server`` and started by
``marknest.service``. Only the Python 3.10 standard library is used.
"""

import argparse
import os
import sys

APP_ROOT = os.environ.get("MARKNEST_ROOT") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__))
)
LIB_DIR = os.path.join(APP_ROOT, "lib")
# ``lib`` is a package, so its parent directory must be importable.
if APP_ROOT not in sys.path:
    sys.path.insert(0, APP_ROOT)
if LIB_DIR not in sys.path:
    sys.path.append(LIB_DIR)

os.environ.setdefault("MARKNEST_ROOT", APP_ROOT)


def main(argv=None):
    from lib import __version__

    parser = argparse.ArgumentParser(
        prog="marknest-server",
        description="MarkNest for TOS - HTTP service over a Unix socket",
    )
    parser.add_argument("--version", action="version", version="marknest %s" % __version__)
    parser.add_argument(
        "--check",
        action="store_true",
        help="validate the runtime environment and exit",
    )
    parser.add_argument(
        "--socket",
        metavar="PATH",
        help="override the socket path (default: /var/api/marknest.sock)",
    )
    parser.add_argument(
        "--dev",
        action="store_true",
        help="development mode: accept unauthenticated requests and use a local socket",
    )
    args = parser.parse_args(argv)

    if args.socket:
        os.environ["MARKNEST_SOCKET"] = args.socket
    if args.dev:
        os.environ["MARKNEST_REQUIRE_AUTH"] = "false"
        os.environ.setdefault(
            "MARKNEST_SOCKET", os.path.join(APP_ROOT, "data", "marknest-dev.sock")
        )
        os.environ.setdefault("MARKNEST_LOG_LEVEL", "DEBUG")

    # Import after the environment is finalised so Config picks up overrides.
    from lib.server import check_environment, serve_forever

    if args.check:
        return check_environment()

    try:
        serve_forever()
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
