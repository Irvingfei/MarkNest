# Environment for MarkNest for TOS
# Loaded by systemd through EnvironmentFile=/usr/local/marknest/marknest.env

# Application identity (used by forward/reverse proxy path normalisation)
MARKNEST_APP_ID=marknest
# It is recommended to align this value with config.ini "path"
MARKNEST_PROXY_PREFIX=/marknest/

# Unix socket that the built-in HTTP server binds to
MARKNEST_SOCKET=/var/api/marknest.sock

# Runtime data locations.
# The index is a derived cache over the files: deleting it costs one rescan and
# loses nothing. It lives here rather than in the shared folder so the user's
# File Manager and SMB listings show notes and nothing else.
MARKNEST_INDEX_DB=/usr/local/marknest/data/index.db
MARKNEST_TMP_DIR=/usr/local/marknest/data/tmp
MARKNEST_LOG_DIR=/usr/local/marknest/logs

# The shared folder the notes live in. postinst creates it with the platform's
# ter_share_add; left to discovery, the application looks for this name on the
# first volume. Set MARKNEST_SHARE_ROOT only to point at a folder the operator
# granted instead.
MARKNEST_SHARE_NAME=marknest-data
# MARKNEST_SHARE_ROOT=/Volume1/marknest-data

# What the editor will open, and the ceiling for a single note. 8 MB is far past
# any hand-written note, so it only ever catches paste accidents.
MARKNEST_NOTE_EXTENSIONS=.md,.markdown,.mdown,.txt
MARKNEST_MAX_NOTE_MB=8

# Index freshness. Deliberately not a filesystem watcher: a note edited over SMB
# or from the File Manager produces no event this process can rely on, so
# changes are found by a stat sweep, which is cheap over a note library.
MARKNEST_SCAN_ENABLED=true
MARKNEST_SCAN_INTERVAL=30
MARKNEST_SCAN_MIN_INTERVAL=2

# Which cookie carries the requesting TOS user. This is the platform's own
# convention - TOS's backend services read the same name.
MARKNEST_USER_COOKIE=tos_current_username

# Log levels: DEBUG | INFO | WARN | ERROR (keep INFO or higher in production)
MARKNEST_LOG_LEVEL=INFO
