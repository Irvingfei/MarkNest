[zh-cn]
name = "MarkNest"
auth = "TerraMaster 社区开发者"
descript = "把笔记以普通 .md 文件的形式保存在 NAS 的共享文件夹里。五个页面：文档列表与文件管理、沉浸阅读、Markdown 编辑（工具栏、大纲导航、图片上传与粘贴、版本记录、导出与分享）、批量上传导入、个人设置。支持全文搜索与保存冲突检测；笔记始终是普通文件，可在文件管理器中打开、通过 SMB 拷走，并由卷快照保留历史版本。"
release_note = "1. 首个版本发布。2. 基于共享文件夹的笔记目录树。3. 分栏 Markdown 编辑器，实时预览与滚动同步。4. 保存时检测冲突。5. 全部笔记的全文搜索。6. 每位用户独立的笔记库。7. 界面重构为五个页面：文档列表、阅读、编辑、导入、设置。8. 编辑器新增 Markdown 工具栏与标题大纲导航。9. 支持图片上传与粘贴插入。10. 新增版本记录与历史版本恢复。11. 支持导出与分享。12. 新增批量导入与逐文件结果提示。13. 新增深色主题、字体与语言等个人设置。 1.1.002：界面语言扩展到九种；左侧边栏可拖动调整宽度；修复占位符与重复标题；优化应用图标与历史版本统计。 1.1.004：切换语言后侧边栏立即同步，并正确跟随 TOS 的语言设置。"
important = "笔记保存在应用安装时创建的共享文件夹 marknest-data 中。每位用户只能看到自己的笔记库。卸载应用不会删除该文件夹。"

[zh-hk]
