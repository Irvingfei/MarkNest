[en-us]
name = "MarkNest"
auth = "TerraMaster Community Developer"
descript = "A Markdown note library that keeps your notes as ordinary .md files in a shared folder on the NAS. Five pages: document list and file management, a focused reader, a Markdown editor with toolbar, outline navigation, image upload and paste, version history, export and sharing, plus batch import and personal settings. Full-text search and save-conflict detection, while the notes stay plain files you can open from the File Manager, copy over SMB, and keep in volume snapshots."
release_note = "1. First release. 2. Note tree over a shared folder. 3. Split-pane Markdown editor with live preview and scroll sync. 4. Saving detects conflicts. 5. Full-text search across every note. 6. A separate library for each user. 7. Rebuilt interface with five pages: library, reader, editor, import, and settings. 8. Markdown toolbar and heading outline in the editor. 9. Insert images by upload or paste. 10. Version history with restore. 11. Export and share a note. 12. Batch import with a per-file result. 13. Dark theme, font, language, and other personal settings. 1.1.002: nine interface languages; a resizable sidebar; fixed placeholders and duplicated titles; a refreshed icon and accurate version statistics. 1.1.004: the sidebar switches language immediately, and the interface now follows the TOS language setting."
important = "Notes are kept in a shared folder named marknest-data that the application creates when it is installed. Each user sees only their own library. Uninstalling the application never deletes that folder."

